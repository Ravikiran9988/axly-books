# ==============================================================================
# AXLY Books (books.axly.in) — Environment Configuration Template
# ==============================================================================
# Copy this template to .env.local for local development.
# In production (e.g., Vercel), configure these in your Environment Variables dashboard.
# NEVER commit raw production credentials, passwords, or secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Neon PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# Pooled Serverless Connection URL from Neon Console (https://console.neon.tech).
# Ensure sslmode=require is present.
DATABASE_URL="postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require"

# ------------------------------------------------------------------------------
# 2. Public Canonical Application URL
# ------------------------------------------------------------------------------
# In development: http://localhost:3000
# In staging/production: https://books.axly.in
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. Transactional Email Delivery (Resend)
# ------------------------------------------------------------------------------
# Required for honest password recovery and transactional notifications.
# Obtain an API key from https://resend.com/api-keys
RESEND_API_KEY="re_1234567890abcdef"
EMAIL_FROM="AXLY Books <noreply@books.axly.in>"

# ------------------------------------------------------------------------------
# 4. Digital Asset / Cover Storage (Vercel Blob)
# ------------------------------------------------------------------------------
# Used by Admin CMS for book cover images and diagrams.
# Provisioned via `vercel blob` or the Vercel Storage dashboard.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxx"

# ------------------------------------------------------------------------------
# 5. Runtime Environment
# ------------------------------------------------------------------------------
NODE_ENV="development"
