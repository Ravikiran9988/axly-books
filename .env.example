# ==============================================================================
# AXLY Books (books.axly.in) — Environment Configuration Template
# ==============================================================================
# Copy this template to .env.local for local development:
#   cp .env.example .env.local
# In production (e.g. Vercel), configure these in your Project Settings > Environment Variables.
# NEVER commit raw production credentials, passwords, or secrets to Git.
# ==============================================================================

# ==============================================================================
# SECTION A: MANDATORY PRODUCTION CONFIGURATION
# (The platform cannot operate persistently without these variables configured)
# ==============================================================================

# 1. Neon PostgreSQL Pooled Connection URL (https://console.neon.tech)
# Mandatory for user sessions, bookmarks, reading progress, and CMS content.
# Ensure sslmode=require is included at the end.
DATABASE_URL="postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require"

# 2. Public Canonical Application URL
# Mandatory for password recovery redirects, metadata tags, and OpenGraph URLs.
# In local development: http://localhost:3000
# In production: https://books.axly.in
NEXT_PUBLIC_APP_URL="https://books.axly.in"


# ==============================================================================
# SECTION B: OPTIONAL INTEGRATION SERVICES
# (Gracefully degrades with truthful messaging if omitted)
# ==============================================================================

# 3. Persistent Object Storage (Vercel Blob)
# Used by Admin CMS for uploading book covers and illustrations directly.
# If omitted or unconfigured: File upload operation safely returns an honest 503
# message, and book covers can still be set by entering an external HTTPS image URL.
# Provisioned via: vercel blob or Vercel Dashboard > Storage > Blob
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxx"

# 4. Transactional Email Delivery (Resend)
# Used for dispatching password reset verification emails.
# If omitted: In development mode, the reset link is logged safely to the server console.
# In production mode, users receive an honest 503 response requesting author assistance.
# Obtain key at: https://resend.com/api-keys
RESEND_API_KEY="re_1234567890abcdef"
EMAIL_FROM="AXLY Books <noreply@books.axly.in>"


# ==============================================================================
# SECTION C: RUNTIME ENVIRONMENT
# ==============================================================================
# Set automatically by Next.js and Vercel ('development' | 'production' | 'test')
NODE_ENV="development"
